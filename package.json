{
  "name": "figma-agent-ui",
  "version": "1.6.4",
  "description": "Figma plugin + MCP server that lets an AI agent read, create, edit and screenshot designs",
  "main": "code.js",
  "bin": {
    "figma-agent-ui": "bin/figma-agent-ui.mjs"
  },
  "files": [
    "bin",
    "dist",
    "code.js",
    "ui.html",
    "manifest.json",
    ".claude/skills/figma-agent-tools",
    ".claude/skills/figma-ui-flow",
    ".claude/skills/asset-generator",
    ".claude/skills/design-md-writer",
    ".claude/skills/style-direction",
    ".claude/skills/icon-libraries"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "node scripts/build.mjs all",
    "build": "node scripts/build.mjs all",
    "build:plugin": "node scripts/build.mjs plugin",
    "build:server": "node scripts/build.mjs server",
    "watch": "node scripts/build.mjs plugin --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "sync:plugin": "node scripts/build.mjs all && node scripts/sync-plugin.mjs"
  },
  "author": "Nguyen Luong Nam <nguyennam.kkb@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "*",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  }
}
